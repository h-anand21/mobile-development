{
  "expo": {
    "name": "SyncDrive",
    "slug": "Project-5-DriverSensors",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "syncdrive",
    "icon": "./assets/icon/black -icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.syncdrive.app",
      "buildNumber": "1",
      "icon": "./assets/icon/black -icon.png"
    },
    "android": {
      "package": "com.syncdrive.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon/black -icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you set a profile avatar.",
          "cameraPermission": "The app accesses your camera to let you take a profile photo."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SyncDrive to access your location to track driving safety."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2a130fc2-546d-42c3-bc80-1849164805c9"
      }
    }
  }
}
