{
  "expo": {
    "name": "HabitFlow",
    "slug": "habitflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "habitflow",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.himanshu.habitflow"
    },
    "android": {
      "package": "com.himanshu.habitflow",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.himanshu.habitflow",
      "infoPlist": {
        "NSMotionUsageDescription": "This app uses your motion sensor data to track your daily steps, distance, and calories burned."
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
